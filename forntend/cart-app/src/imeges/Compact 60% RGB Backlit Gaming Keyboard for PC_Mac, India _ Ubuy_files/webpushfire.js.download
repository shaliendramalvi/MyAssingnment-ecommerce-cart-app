                } else {
                    getRegToken('allow');
                }
            }
        });
    }
}


function getRegToken(permission) {
    const currentToken = getToken(messaging, { vapidKey: 'BFItmIfyjCHJX83gYWGnAJN6WGWLR73IcIUddIoyEHXXuK3naXXYmjJmQ9TRAggyHqTrfpjEzOHvNaSWz0ekgbc' })
        .then(function (currentToken) {
            if (currentToken) {
                var token = currentToken;
                console.log("token => "+token);
                jQuery("#devicetoken").html(token);
                var tokenJson = { permission: permission, token: token, device_id: uba_cookieId };
                saveToken(tokenJson);
            }
        }).catch(function (err) {


        });

}




function isTokenSentToServer() {
    return getCacheWithExpiryNew('sentToServer');
}

function saveToken(tokenJson) {

    tokenJson.siteurl = uba_baseurl;
    tokenJson.weburl = uba_weburl;
    tokenJson.currenturl = uba_currenturl;
    tokenJson.useragent = userAgentType;
    tokenJson.userip = uba_user_ip;
    tokenJson.store_id = uba_store_id;
    tokenJson.website_id = uba_website_id;
    tokenJson.page = uba_currentPage;
    tokenJson.is_mobile = uba_is_mobile;
    tokenJson.hostname = uba_hostname;
    tokenJson.current_url = uba_currenturl;
    tokenJson.new_device_id = uba_cookieId;
    jQuery.ajax({
        url: WEBPUSH_URL + 'savetoken.php?action=savetoken',
        method: 'post',
        data: tokenJson
    })
        .done(function (result) {                      
            result = JSON.parse(result);
            if (result.data.permission == 'allow' && result.status == true) {
                setCacheWithExpiryNew('sentToServer', result.status, 3600*2);
            }

        })
}

onMessage(function (payload) {
    var notificationTitle = payload.data.title;
    const notificationOptions = {
        body: payload.data.body,
        icon: payload.data.icon,
        image: payload.data.image,
        click_action: payload.data.url,
        data: {
            click_action: payload.data.url
        }
    };

    var notification = new Notification(notificationTitle, notificationOptions);
});

function setCacheWithExpiryNew(key, value, minute) {

    const now = new Date();
    const item = {
        value: value,
        expiry: now.getTime() + minute * 60000,
    }
    localStorage.setItem(key, JSON.stringify(item))
}

function getCacheWithExpiry(key) {
    const itemStr = localStorage.getItem(key)
    if (!itemStr) {
        return "";
    }
    const item = JSON.parse(itemStr);
    const now = new Date()
    if (now.getTime() > item.expiry) {
        localStorage.removeItem(key);
        return "";
    }
    return item.value
}



