var userAgentType = navigator.userAgent;
var uba_hostname = window.location.origin;
var uba_currenturl = window.location.href.toString();
var newcookie = "";

var WEBPUSH_URL = uba_baseurl + "ubuywebanalytics/";
navigator.serviceWorker.getRegistrations().then(function (registrations) {
    for (let registration of registrations) {
        registration.update();
    }
})
function getCacheWithExpiryNew(key) {
    const itemStr = localStorage.getItem(key)

    if (!itemStr) {
        return "";
    }
    const item = JSON.parse(itemStr);
    const now = new Date()
    if (now.getTime() > item.expiry) {
        localStorage.removeItem(key);
        return "";
    }

    return item.value
}
function getMiliSecondTime() {
    var d = new Date();
    var time = d.getTime();
    return time;
}

function newcookieId() {
    var navigator_info = window.navigator;
    var screen_info = window.screen;
    var uid = navigator_info.mimeTypes.length;
    uid += navigator_info.userAgent.replace(/\D+/g, '');
    uid += navigator_info.plugins.length;
    uid += screen_info.height || '';
    uid += screen_info.width || '';
    uid += screen_info.pixelDepth || '';

    return uid;

}



function setTrackCookiesNew() {

    cookie = newcookieId();
    var time = getMiliSecondTime();
    var uuid = cookie + time
    //setCacheWithExpiryNew('new_session_id', uuid, 525600);
    return uuid;
}



